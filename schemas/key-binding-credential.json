{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dplaax.dev/schemas/key-binding-credential.json",
  "title": "KeyBindingCredential wire form",
  "$comment": "Structural residue of the keybinding.* rules: the members, their types and spellings. What a verifier checks against its trust anchor, its own identifier, the clock and the status list it holds (keybinding.issuer, .validity, .audience, .status.entry, .status-list.fresh) is behavioral and pinned by the vectors. The wire carries no JSON number. Members are exact: a member not named here is refused, so that no reader honours a claim another ignores.",
  "type": "object",
  "required": ["@context", "type", "issuer", "validFrom", "validUntil", "credentialStatus", "credentialSubject", "proof"],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "const": ["https://www.w3.org/ns/credentials/v2", "https://dplaax.dev/vc/v1"]
    },
    "type": {
      "const": ["VerifiableCredential", "KeyBindingCredential"],
      "$comment": "keybinding.shape"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:",
      "$comment": "keybinding.issuer: the DID a trust anchor names."
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "$comment": "credential.field.valid-from: UTC to the second."
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "$comment": "keybinding.shape: later than validFrom (cross-field, vector-pinned)."
    },
    "credentialStatus": {
      "type": "object",
      "required": ["type", "statusPurpose", "statusListIndex", "statusListCredential"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "BitstringStatusListEntry" },
        "statusPurpose": { "const": "revocation" },
        "statusListIndex": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "$comment": "keybinding.status.entry: a decimal string without leading zeros."
        },
        "statusListCredential": {
          "type": "string",
          "pattern": "^did:[^#?/]+#(?![.]+$)[A-Za-z0-9._-]+$",
          "$comment": "keybinding.status-list.id: a DID URL; that its DID is the issuer's is cross-field (vector-pinned)."
        }
      }
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "kind", "roles", "audience", "keyClass", "key"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "$comment": "The subject, in the issuer's namespace." },
        "kind": { "type": "string", "minLength": 1, "$comment": "The profile's vocabulary." },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "$comment": "The profile's vocabulary; none is an empty array."
        },
        "audience": {
          "type": "string",
          "pattern": "^did:",
          "$comment": "keybinding.audience: the relying party's organization DID."
        },
        "keyClass": { "type": "string", "minLength": 1, "$comment": "The profile's vocabulary." },
        "key": {
          "type": "object",
          "required": ["keyId", "publicKeyJwk"],
          "additionalProperties": false,
          "properties": {
            "keyId": { "type": "string", "minLength": 1, "$comment": "The key's id, as the signatures by it name it." },
            "publicKeyJwk": {
              "$comment": "An RFC 7517 public JWK of exactly the members RFC 7638 hashes for its kty, every value but kty and crv unpadded base64url.",
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kty", "crv", "x"],
                  "additionalProperties": false,
                  "properties": {
                    "kty": { "const": "OKP" },
                    "crv": { "const": "Ed25519" },
                    "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
                  }
                },
                {
                  "type": "object",
                  "required": ["kty", "crv", "x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "kty": { "const": "EC" },
                    "crv": { "const": "P-256" },
                    "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
                    "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
                  }
                },
                {
                  "type": "object",
                  "required": ["kty", "n", "e"],
                  "additionalProperties": false,
                  "properties": {
                    "kty": { "const": "RSA" },
                    "n": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                    "e": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "verificationMethod", "proofPurpose", "proofValue"],
      "additionalProperties": true,
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "type": "string" },
        "verificationMethod": {
          "type": "string",
          "$comment": "keybinding.issuer: one of the issuance keys the issuer's trust anchor names (behavioral)."
        },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "pattern": "^z" }
      }
    }
  }
}
