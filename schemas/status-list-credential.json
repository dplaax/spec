{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dplaax.dev/schemas/status-list-credential.json",
  "title": "Key-binding revocation list (BitstringStatusListCredential) wire form",
  "$comment": "Structural residue of the keybinding.status-list.* rules. That the id's DID is the issuer's, that validUntil is later than validFrom, what the encodedList expands to and how a list compares with the one held are cross-field or behavioral and pinned by the vectors. The top level and credentialSubject are open, as in key-binding-credential.json; the content hash covers every member (keybinding.status-list.content-hash).",
  "type": "object",
  "required": ["@context", "type", "id", "issuer", "validFrom", "validUntil", "credentialSubject", "proof"],
  "additionalProperties": true,
  "properties": {
    "@context": {
      "const": ["https://www.w3.org/ns/credentials/v2"]
    },
    "type": {
      "const": ["VerifiableCredential", "BitstringStatusListCredential"]
    },
    "id": {
      "type": "string",
      "pattern": "^did:[^#?/]+#[A-Za-z0-9._-]*[A-Za-z0-9_-][A-Za-z0-9._-]*$",
      "$comment": "keybinding.status-list.id: <issuer>#fragment (the DID being the issuer's is vector-pinned)."
    },
    "issuer": { "type": "string", "pattern": "^did:" },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "$comment": "keybinding.status-list.period"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "$comment": "keybinding.status-list.period: later than validFrom (cross-field, vector-pinned)."
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "type", "statusPurpose", "encodedList"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "$comment": "The list itself, as the credential's subject." },
        "type": { "const": "BitstringStatusList" },
        "statusPurpose": { "const": "revocation" },
        "encodedList": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]+$",
          "$comment": "Multibase base64url (no padding) of the GZIP of the bitstring (W3C Bitstring Status List). The content hash covers the expanded bits, not this encoding (keybinding.status-list.content-hash)."
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "verificationMethod", "proofPurpose", "proofValue"],
      "additionalProperties": true,
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "pattern": "^z" }
      }
    }
  }
}
