{
  "id": "registry-001",
  "rule": "registry.append-only",
  "description": "コミット済みエントリの同一版識別子での再コミット（内容差し替え）は不可",
  "input": {
    "sequence": [
      {
        "op": "commit",
        "key": "schema/orders",
        "version": "3",
        "contentHash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      {
        "op": "commit",
        "key": "schema/orders",
        "version": "3",
        "contentHash": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
      }
    ]
  },
  "expect": "reject"
}
