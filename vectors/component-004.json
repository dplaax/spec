{
  "id": "component-004",
  "rule": "component.external-sink.verify",
  "description": "An External Sink terminates without verifying the received chain",
  "input": {
    "component_type": "ExternalSink",
    "sequence": [
      {
        "op": "receive"
      },
      {
        "op": "terminate"
      }
    ]
  },
  "expect": "reject"
}
